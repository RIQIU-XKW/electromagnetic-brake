          <layout class="QVBoxLayout" name="verticalLayoutPresetContent">
           <item>
            <widget class="QGroupBox" name="groupBoxBrakeDuty">
             <property name="title">
              <string>制动占空比 / 死区(五路 H 桥同步: 左桥常开 + 右桥斩波)</string>
             </property>
             <layout class="QGridLayout" name="gridLayoutBrakeDuty">
              <item row="0" column="0">
               <widget class="QLabel" name="labelBrakeDuty">
                <property name="text">
                 <string>占空比(Q4)</string>
                </property>
               </widget>
              </item>
              <item row="0" column="1" colspan="3">
               <widget class="QSlider" name="sliderBrakeDuty">
                <property name="toolTip">
                 <string>拖动即时下发 [0xDA][高字节][低字节][0xDB], 取值 0..70(%) —— 现场限制不超过 70%。五路桥用同一个占空比: 制动开着时立刻生效, 没开则先记住, 等 0xA0+0xA1 启动时使用。</string>
                </property>
                <property name="minimum">
                 <number>0</number>
                </property>
                <property name="maximum">
                 <number>70</number>
                </property>
                <property name="value">
